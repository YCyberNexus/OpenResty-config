{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "OpenAI Chat Completions 请求体的标准 JSON Schema 草稿。当前起步骨架用 lua/waf/body_validator.lua（自研校验器）实现等价约束；本文件是方案 P3-3 迁移到 lua-resty-jsonschema 的目标。数值上限待接口契约（方案搁置项 5）确认后据实收紧。",
  "type": "object",
  "additionalProperties": false,
  "required": ["model", "messages"],
  "properties": {
    "model": {
      "type": "string",
      "enum": ["gpt-4o", "gpt-4o-mini", "claude-opus-4-8"]
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": { "type": "string", "enum": ["system", "user", "assistant"] },
          "content": { "type": "string", "maxLength": 8000 },
          "name": { "type": "string", "maxLength": 64 }
        }
      }
    },
    "stream": { "type": "boolean" },
    "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
    "top_p": { "type": "number", "minimum": 0, "maximum": 1 },
    "max_tokens": { "type": "integer", "minimum": 1, "maximum": 8192 },
    "n": { "type": "integer", "minimum": 1, "maximum": 8 },
    "stop": {
      "anyOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" }, "maxItems": 4 }
      ]
    }
  }
}
