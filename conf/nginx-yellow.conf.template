# 黄区 WAF V2 模板；业务 Host/下一跳不在 Nginx 模板中维护，统一由 Lua 配置控制。
user nobody;
worker_processes auto;
error_log /data/openresty-waf/log/error.log info;
pid /run/openresty-waf/yellow.pid;

events { worker_connections 2048; }

http {
  include waf-http-common.conf;
  client_body_temp_path /data/openresty-waf/client_body_temp 1 2;
  map $http_x_waf_trace_id $waf_peer_trace_id {
    "" $request_id;
    default $http_x_waf_trace_id;
  }
  init_by_lua_block {
    require("waf.handler").init(
      require("waf_rules"), require("waf_routes"), require("waf_policies"), "yellow")
  }
  server {
    listen __YELLOW_WAF_LISTEN_IP__:__YELLOW_WAF_PORT__ default_server;
    server_name "";
    set $waf_node_role "yellow";
    set $waf_trace_id $request_id;
    include waf-audit-vars.conf;
    access_log /data/openresty-waf/audit/rejected.log waf_reject;
    location / {
      return 444;
    }
  }
  include waf-audit-log-format.conf;
  server {
    listen __YELLOW_WAF_LISTEN_IP__:__YELLOW_WAF_PORT__;
    server_name ~^.+$;
    default_type application/json;
    set $waf_node_role "yellow";
    set $waf_trace_id $waf_peer_trace_id;
    include waf-audit-vars.conf;
    access_log /data/openresty-waf/audit/access.log waf_audit;
    add_header X-Request-ID $waf_trace_id always;
    location / { include waf-public-location.conf; }
    include waf-internal-locations.conf;
  }
}
